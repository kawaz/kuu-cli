const SELF_DEFINITION_JSON : String = "{\n  \"$schema\": \"https://raw.githubusercontent.com/kawaz/kuu/main/schema/wire.schema.json\",\n  \"name\": \"kuu\",\n  \"help\": \"Parse, validate, inspect, and complete kuu command definitions.\",\n  \"options\": [\n    {\n      \"name\": \"help\",\n      \"type\": \"help\",\n      \"long\": true,\n      \"global\": true,\n      \"export_key\": \"show_help\",\n      \"help\": \"Show help for the selected command.\"\n    },\n    {\n      \"name\": \"version\",\n      \"type\": \"string\",\n      \"long\": [\":set:0.0.0\"],\n      \"global\": true,\n      \"on_failure\": true,\n      \"help\": \"Print the kuu version.\"\n    }\n  ],\n  \"commands\": [\n    {\n      \"name\": \"parse\",\n      \"type\": \"command\",\n      \"help\": \"Parse arguments using a kuu definition.\",\n      \"options\": [\n        {\n          \"help_group_name\": \"sources\",\n          \"help_group_title\": \"Value source options\"\n        },\n        {\n          \"name\": \"no_env\",\n          \"type\": \"flag\",\n          \"long\": true,\n          \"help_group_name\": \"sources\",\n          \"help\": \"Ignore environment variables.\"\n        },\n        {\n          \"name\": \"env\",\n          \"type\": \"string\",\n          \"long\": true,\n          \"multiple\": \"append\",\n          \"value_name\": \"KEY=VALUE\",\n          \"piece_filters\": [\n            {\n              \"name\": \"regex_match\",\n              \"args\": [\"^[^=]+=.*$\"]\n            }\n          ],\n          \"help_group_name\": \"sources\",\n          \"help\": \"Set an environment variable for the parsed command.\"\n        },\n        {\n          \"name\": \"no_config\",\n          \"type\": \"flag\",\n          \"long\": true,\n          \"exclusive_group\": [\"config_source\"],\n          \"help_group_name\": \"sources\",\n          \"help\": \"Disable configuration value sources.\"\n        },\n        {\n          \"name\": \"config\",\n          \"type\": \"string\",\n          \"long\": true,\n          \"exclusive_group\": [\"config_source\"],\n          \"value_name\": \"JSON_OR_FILE\",\n          \"help_group_name\": \"sources\",\n          \"help\": \"Use one JSON value or file for configuration.\"\n        },\n        {\n          \"name\": \"config_file\",\n          \"long\": true,\n          \"seq\": [\n            {\n              \"name\": \"path\",\n              \"type\": \"string\",\n              \"value_name\": \"PATH\"\n            },\n            {\n              \"name\": \"value\",\n              \"type\": \"string\",\n              \"value_name\": \"JSON_OR_FILE\"\n            }\n          ],\n          \"multiple\": \"append\",\n          \"exclusive_group\": [\"config_source\"],\n          \"help_group_name\": \"sources\",\n          \"help\": \"Map a configuration path to a JSON value or file.\"\n        },\n        {\n          \"name\": \"tty\",\n          \"type\": \"string\",\n          \"long\": true,\n          \"value_name\": \"JSON\",\n          \"help_group_name\": \"sources\",\n          \"help\": \"Override terminal observations with JSON.\"\n        },\n        {\n          \"name\": \"--\",\n          \"type\": \"dd\",\n          \"help\": \"Stop parsing kuu options.\"\n        }\n      ],\n      \"positionals\": [\n        {\n          \"name\": \"definition\",\n          \"type\": \"string\",\n          \"required\": true,\n          \"value_name\": \"DEF_JSON\",\n          \"completer\": \"files\",\n          \"help\": \"Definition JSON file, or - for standard input.\"\n        },\n        {\n          \"name\": \"args\",\n          \"type\": \"string\",\n          \"repeat\": {\"min\": 0},\n          \"value_name\": \"ARG\",\n          \"help\": \"Arguments to parse.\"\n        }\n      ]\n    },\n    {\n      \"name\": \"complete\",\n      \"type\": \"command\",\n      \"help\": \"Compute completion candidates for a definition.\",\n      \"options\": [\n        {\n          \"name\": \"args_before\",\n          \"type\": \"string\",\n          \"long\": true,\n          \"required\": true,\n          \"value_name\": \"JSON_ARRAY\",\n          \"help\": \"Arguments before the cursor as a JSON array.\"\n        },\n        {\n          \"name\": \"args_after\",\n          \"type\": \"string\",\n          \"long\": true,\n          \"value_name\": \"JSON_ARRAY\",\n          \"help\": \"Arguments after the cursor as a JSON array.\"\n        }\n      ],\n      \"positionals\": [\n        {\n          \"name\": \"definition\",\n          \"type\": \"string\",\n          \"required\": true,\n          \"value_name\": \"DEF_JSON\",\n          \"completer\": \"files\",\n          \"help\": \"Definition JSON file, or - for standard input.\"\n        }\n      ]\n    },\n    {\n      \"name\": \"validate\",\n      \"type\": \"command\",\n      \"help\": \"Validate and lower a kuu definition.\",\n      \"positionals\": [\n        {\n          \"name\": \"definition\",\n          \"type\": \"string\",\n          \"required\": true,\n          \"value_name\": \"DEF_JSON\",\n          \"completer\": \"files\",\n          \"help\": \"Definition JSON file, or - for standard input.\"\n        }\n      ]\n    },\n    {\n      \"name\": \"help\",\n      \"type\": \"command\",\n      \"help\": \"Render help for a kuu definition.\",\n      \"options\": [\n        {\n          \"name\": \"path\",\n          \"type\": \"string\",\n          \"long\": true,\n          \"value_name\": \"JSON_ARRAY\",\n          \"help\": \"Command path as a JSON array.\"\n        },\n        {\n          \"name\": \"depth\",\n          \"long\": true,\n          \"values\": [\"scope\", \"all\"],\n          \"value_name\": \"DEPTH\",\n          \"help\": \"Render one scope or the full command tree.\"\n        },\n        {\n          \"name\": \"category_mode\",\n          \"type\": \"string\",\n          \"long\": true,\n          \"value_filters\": [\n            {\n       