}\n          ],\n          \"positionals\": [\n            {\n              \"name\": \"definition\",\n              \"type\": \"string\",\n              \"required\": true,\n              \"value_name\": \"DEF_JSON\",\n              \"completer\": \"files\",\n              \"help\": \"Definition JSON file, or - for standard input.\"\n            }\n          ]\n        },\n        {\n          \"name\": \"query\",\n          \"type\": \"command\",\n          \"help\": \"Query completion candidates directly.\",\n          \"options\": [\n            {\n              \"name\": \"cword\",\n              \"type\": \"int\",\n              \"long\": true,\n              \"value_name\": \"INDEX\",\n              \"help\": \"Cursor word index.\"\n            },\n            {\n              \"name\": \"--\",\n              \"type\": \"dd\",\n              \"help\": \"Stop parsing kuu options.\"\n            }\n          ],\n          \"positionals\": [\n            {\n              \"name\": \"definition\",\n              \"type\": \"string\",\n              \"required\": true,\n              \"value_name\": \"DEF_JSON\",\n              \"completer\": \"files\",\n              \"help\": \"Definition JSON file, or - for standard input.\"\n            },\n            {\n              \"name\": \"words\",\n              \"type\": \"string\",\n              \"repeat\": {\"min\": 0},\n              \"value_name\": \"WORD\",\n              \"help\": \"Command words including the program name.\"\n            }\n          ]\n        }\n      ]\n    }\n  ]\n}\n"
